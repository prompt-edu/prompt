# node_modules MUST stay ignored: Dockerfile installs into /app/node_modules
# before the final `COPY . ./`, and COPY merges rather than replaces. Un-ignoring
# node_modules would overwrite the container's install with the host's.
node_modules
**/node_modules
build
**/build
.git
.gitignore
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Regenerated by `yarn install`. Since the install now runs before the source is
# copied, the host's copy would otherwise land on top of the container's. Do not
# widen this to `.yarn/` - a future `yarn set version` commits .yarn/releases,
# which the install would then need.
.yarn/install-state.gz
