  },
  "dependencies": {
    "html2canvas-pro": "2.5.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@types/papaparse": "^5.5.2"
  },
  "packageManager": "yarn@4.18.1"
}
