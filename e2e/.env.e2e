# ============================================================================
# Environment for the E2E docker-compose stack (docker-compose.e2e.yml).
#
# These are TEST-ONLY credentials for an ephemeral, throwaway stack. They are
# committed on purpose so `make test-e2e` works out of the box, locally and in
# CI, with zero setup. Do NOT put real secrets here.
# ============================================================================

ENVIRONMENT=development
DEBUG=true
SERVER_ADDRESS=0.0.0.0:8080
SSL_MODE=disable

# Service-name URLs on the compose network (the containerized runner's browser
# resolves these via Docker DNS). CORE_HOST is the browser origin used for the
# server's CORS allow-list; CORE_API_HOST is the API base baked into the client's
# env.js and used by the browser/Node for API calls.
# Host ports are still published (client 4000 / server 18090 / keycloak 18081) so
# the stack runs alongside a dev stack and is reachable for manual poking.
CORE_HOST=http://client-core
CORE_API_HOST=http://server-core:8080
# Core URL used by phase servers (prompt-sdk) for the is_student auth round-trip.
SERVER_CORE_HOST=http://server-core:8080

CHAIR_NAME_SHORT=AET
CHAIR_NAME_LONG=Applied Education Technologies
GITHUB_SHA=e2e
GITHUB_REF=e2e
SERVER_CORE_IMAGE_TAG=local

# ─── Core database ──────────────────────────────────────────────────────────
DB_CORE_HOST=db
DB_CORE_PORT=5432
DB_CORE_NAME=prompt
DB_CORE_USER=prompt-postgres
DB_CORE_PASSWORD=prompt-postgres

# ─── Keycloak ───────────────────────────────────────────────────────────────
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

KEYCLOAK_HOST=http://keycloak:8080
KEYCLOAK_REALM_NAME=prompt
KEYCLOAK_CLIENT_ID=prompt-server
# The committed realm stores this literal value as the prompt-server secret.
KEYCLOAK_CLIENT_SECRET=**********
KEYCLOAK_ID_OF_CLIENT=a584ca61-fa83-4e95-98b6-c5f3157ae4b4
KEYCLOAK_AUTHORIZED_PARTY=prompt-client
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Self team allocation database ──────────────────────────────────────────
DB_SELF_TEAM_ALLOCATION_HOST=db-self-team-allocation
DB_SELF_TEAM_ALLOCATION_PORT=5432
DB_SELF_TEAM_ALLOCATION_NAME=prompt
DB_SELF_TEAM_ALLOCATION_USER=prompt-postgres
DB_SELF_TEAM_ALLOCATION_PASSWORD=prompt-postgres

# ─── Assessment database ─────────────────────────────────────────────────────
DB_ASSESSMENT_HOST=db-assessment
DB_ASSESSMENT_PORT=5432
DB_ASSESSMENT_NAME=prompt
DB_ASSESSMENT_USER=prompt-postgres
DB_ASSESSMENT_PASSWORD=prompt-postgres

# ─── Interview database ──────────────────────────────────────────────────────
DB_INTERVIEW_HOST=db-interview
DB_INTERVIEW_PORT=5432
DB_INTERVIEW_NAME=prompt
DB_INTERVIEW_USER=prompt-postgres
DB_INTERVIEW_PASSWORD=prompt-postgres

# ─── Certificate database ────────────────────────────────────────────────────
DB_CERTIFICATE_HOST=db-certificate
DB_CERTIFICATE_PORT=5432
DB_CERTIFICATE_NAME=prompt
DB_CERTIFICATE_USER=prompt-postgres
DB_CERTIFICATE_PASSWORD=prompt-postgres

# ─── Presentation database ───────────────────────────────────────────────────
DB_PRESENTATION_HOST=db-presentation
DB_PRESENTATION_PORT=5432
DB_PRESENTATION_NAME=prompt
DB_PRESENTATION_USER=prompt-postgres
DB_PRESENTATION_PASSWORD=prompt-postgres

# ─── Team allocation database ────────────────────────────────────────────────
DB_TEAM_ALLOCATION_HOST=db-team-allocation
DB_TEAM_ALLOCATION_PORT=5432
DB_TEAM_ALLOCATION_NAME=prompt
DB_TEAM_ALLOCATION_USER=prompt-postgres
DB_TEAM_ALLOCATION_PASSWORD=prompt-postgres

# ─── Example database ────────────────────────────────────────────────────────
DB_EXAMPLE_HOST=db-example
DB_EXAMPLE_PORT=5432
DB_EXAMPLE_NAME=prompt
DB_EXAMPLE_USER=prompt-postgres
DB_EXAMPLE_PASSWORD=prompt-postgres

# ─── Micro-frontend hosts (referenced by the core client's env.js) ──────────
# Empty = same-origin: the component's API calls go to the browser origin
# (client-core) and are proxied to the phase server by e2e/nginx/client-core.conf.
SELF_TEAM_ALLOCATION_HOST=
ASSESSMENT_HOST=
INTERVIEW_HOST=
CERTIFICATE_HOST=
PRESENTATION_HOST=
TEAM_ALLOCATION_HOST=
EXAMPLE_HOST=
# The remaining modules are not part of the e2e stack (yet).
INTRO_COURSE_HOST=http://localhost:8082
DEVOPS_CHALLENGE_HOST=http://localhost:9010

# ─── S3 (SeaweedFS) ─────────────────────────────────────────────────────────
S3_BUCKET=prompt-files
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_PUBLIC_ENDPOINT=http://seaweedfs-s3:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_UPLOAD_TTL_SECONDS=60
S3_PRESIGN_DOWNLOAD_TTL_SECONDS=30
MAX_FILE_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/gif,application/zip,text/plain
PRESENTATION_ALLOWED_FILE_TYPES=application/pdf,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.oasis.opendocument.presentation,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.oasis.opendocument.text,image/png,image/jpeg,application/zip,application/x-zip-compressed,video/mp4

# ─── Audit log ──────────────────────────────────────────────────────────────
# Core's accepted ingest keys, one per reporting phase service. TEST-ONLY
# values: they authenticate nothing outside this throwaway stack.
AUDIT_INGEST_KEYS=assessment:e2e-audit-assessment,certificate:e2e-audit-certificate,example-service:e2e-audit-example-service,interview:e2e-audit-interview,presentation:e2e-audit-presentation,self-team-allocation:e2e-audit-self-team-allocation,team-allocation:e2e-audit-team-allocation

# Each phase container's own key, mapped onto AUDIT_INGEST_KEY by the compose
# file. Every value must also appear in AUDIT_INGEST_KEYS above.
AUDIT_INGEST_KEY_ASSESSMENT=e2e-audit-assessment
AUDIT_INGEST_KEY_CERTIFICATE=e2e-audit-certificate
AUDIT_INGEST_KEY_EXAMPLE_SERVER=e2e-audit-example-service
AUDIT_INGEST_KEY_INTERVIEW=e2e-audit-interview
AUDIT_INGEST_KEY_PRESENTATION=e2e-audit-presentation
AUDIT_INGEST_KEY_SELF_TEAM_ALLOCATION=e2e-audit-self-team-allocation
AUDIT_INGEST_KEY_TEAM_ALLOCATION=e2e-audit-team-allocation
