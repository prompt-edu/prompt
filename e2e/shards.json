{
  "$comment": "Shard partition for CI. 'paths' are Playwright regexes matched against the absolute spec path, anchored on both ends. Run `npm run check-shards` after editing. See e2e/README.md.",
  "shards": [
    {
      "name": "core",
      "cacheWriter": false,
      "paths": [
        "/tests/application/.*\\.spec\\.ts$",
        "/tests/audit-log/.*\\.spec\\.ts$",
        "/tests/auth/.*\\.spec\\.ts$",
        "/tests/configurator/.*\\.spec\\.ts$",
        "/tests/course-staff/.*\\.spec\\.ts$",
        "/tests/courses/.*\\.spec\\.ts$",
        "/tests/students/.*\\.spec\\.ts$",
        "/tests/permissions/.*\\.spec\\.ts$",
        "/tests/api/courses\\.api\\.spec\\.ts$",
        "/tests/api/application-apply\\.api\\.spec\\.ts$",
        "/tests/api/application-files\\.api\\.spec\\.ts$",
        "/tests/api/course-staff\\.api\\.spec\\.ts$"
      ]
    },
    {
      "name": "interview",
      "cacheWriter": false,
      "paths": [
        "/tests/interview/.*\\.spec\\.ts$",
        "/tests/api/interview\\.api\\.spec\\.ts$"
      ]
    },
    {
      "name": "matching",
      "cacheWriter": false,
      "paths": [
        "/tests/matching/.*\\.spec\\.ts$",
        "/tests/api/matching\\.api\\.spec\\.ts$"
      ]
    },
    {
      "name": "team-allocation",
      "cacheWriter": false,
      "paths": [
        "/tests/team-allocation/.*\\.spec\\.ts$",
        "/tests/api/team-allocation\\.api\\.spec\\.ts$"
      ]
    },
    {
      "name": "self-team-allocation",
      "cacheWriter": false,
      "paths": [
        "/tests/self-team-allocation/.*\\.spec\\.ts$",
        "/tests/api/self-team-allocation\\.api\\.spec\\.ts$"
      ]
    },
    {
      "name": "assessment",
      "cacheWriter": false,
      "paths": [
        "/tests/assessment/.*\\.spec\\.ts$",
        "/tests/api/assessment\\.api\\.spec\\.ts$"
      ]
    },
    {
      "name": "certificate",
      "cacheWriter": false,
      "paths": [
        "/tests/certificate/.*\\.spec\\.ts$",
        "/tests/api/certificate\\.api\\.spec\\.ts$"
      ]
    },
    {
      "name": "example",
      "cacheWriter": true,
      "paths": [
        "/tests/example/.*\\.spec\\.ts$",
        "/tests/api/example\\.api\\.spec\\.ts$"
      ]
    }
  ]
}
