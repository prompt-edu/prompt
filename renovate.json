{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "Dependencies:",
  "prConcurrentLimit": 3,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Group all non-major updates together",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "No minimum age for security updates",
      "matchCategories": ["security"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "No minimum age for the packages we maintain ourselves",
      "matchPackageNames": [
        "@tumaet/prompt-shared-state",
        "@tumaet/prompt-ui-components",
        "github.com/prompt-edu/prompt-sdk"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}
