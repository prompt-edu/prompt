import type { SidebarMenuItemProps } from '@tumaet/prompt-shared-state'
import React from 'react'
import { DisabledSidebarMenuItem } from '../../layout/Sidebar/InsideSidebar/components/DisabledSidebarMenuItem'
import { ExternalSidebarComponent } from './ExternalSidebar'

interface {{pascal}}SidebarProps {
  rootPath: string
  title?: string
  coursePhaseID: string
}

export const {{pascal}}Sidebar = React.lazy(() =>
  import('{{name}}_component/sidebar')
    .then((module): { default: React.FC<{{pascal}}SidebarProps> } => ({
      default: ({ title, rootPath, coursePhaseID }) => {
        const sidebarElement: SidebarMenuItemProps = module.default || {}
        return (
          <ExternalSidebarComponent
            title={title}
            rootPath={rootPath}
            sidebarElement={sidebarElement}
            coursePhaseID={coursePhaseID}
          />
        )
      },
    }))
    .catch((): { default: React.FC } => ({
      default: () => {
        console.warn('Failed to load {{readable_lower}} sidebar')
        return <DisabledSidebarMenuItem title={'{{readable}} Not Available'} />
      },
    })),
)
