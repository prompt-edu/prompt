  client-{{kebab}}-component:
    build:
      context: ./clients/{{name}}_component
      dockerfile: Dockerfile
      args: *client-build-args
      additional_contexts: *client-additional-contexts
    container_name: ${PROMPT_CONTAINER_PREFIX:-prompt}-client-{{kebab}}-component
    ports:
      - "${PROMPT_PORT_{{client_port}}:-{{client_port}}}:80"
    depends_on:
      - clients-base

